@model IEnumerable<SLMS.Models.Entities.CustodyHistory>

<h2>Custody History</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Book</th>
            <th>From</th>
            <th>To</th>
            <th>Date</th>
            <th>Remarks</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Book?.Title</td>
                <td>@item.FromDepartment</td>
                <td>@item.ToDepartment</td>
                <td>@item.TransferDate.ToString("dd-MMM-yyyy HH:mm")</td>
                <td>@item.Remarks</td>
            </tr>
        }
    </tbody>
</table>