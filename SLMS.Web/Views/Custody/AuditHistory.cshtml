@model IEnumerable<SLMS.Models.Entities.AuditLog>

<h2>Audit History</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Action</th>
            <th>Entity</th>
            <th>Description</th>
            <th>Date</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Action</td>
                <td>@item.EntityName</td>
                <td>@item.Description</td>
                <td>@item.CreatedAt.ToString("dd-MMM-yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
